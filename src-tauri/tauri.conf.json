{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nihongo",
  "version": "0.1.0",
  "identifier": "de.nihongo.app",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "node build.cjs",
    "beforeBuildCommand": "node build.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nihongo",
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
